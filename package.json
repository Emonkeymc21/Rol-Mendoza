{
  "name": "rol-mendoza",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:share-preview": "node scripts/test-share-preview.cjs",
    "test:stability": "node scripts/test-stability.cjs",
    "test:ci": "npm run test:share-preview && npm run test:stability",
    "test:unit": "ng test --watch=false",
    "test:production-csp": "node scripts/test-production-csp.mjs",
    "test:emulators": "firebase emulators:exec --config firebase.test.json --only auth,firestore --project demo-cumbre20 --non-interactive \"node --test --test-concurrency=1 --test-timeout=60000 tests/*.test.mjs\"",
    "test:e2e": "node scripts/run-e2e.cjs",
    "audit:build": "ng build --configuration=production,audit",
    "audit:browser": "firebase emulators:exec --config firebase.test.json --only auth,firestore --project demo-cumbre20 --non-interactive \"node scripts/audit-browser.mjs\""
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@angular/router": "^22.2.5",
    "firebase": "13.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@axe-core/playwright": "4.14.0",
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.65.0",
    "autoprefixer": "^10.4.20",
    "firebase-tools": "15.35.0",
    "jsdom": "^31.0.0",
    "lighthouse": "13.6.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7",
    "glob@>=9.0.0 <14.0.2": "14.0.4",
    "uuid@<11.1.1": "11.1.1",
    "@google-cloud/pubsub": "6.3.2"
  }
}
