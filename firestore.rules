rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownDocument(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validRole(role) {
      return role == 'DM' || role == 'PLAYER' || role == 'BOTH';
    }

    function validAvatarClass(avatar) {
      return avatar in [
        'BARBARIAN', 'BARD', 'CLERIC', 'PALADIN', 'RANGER', 'ROGUE',
        'DRUID', 'FIGHTER', 'MONK', 'SORCERER', 'WARLOCK', 'WIZARD'
      ];
    }

    function validJoinStatus(status) {
      return status in ['PENDING', 'APPROVED', 'REJECTED'];
    }

    function currentUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function completedViewer() {
      return signedIn()
        && currentUserData().active == true
        && currentUserData().profileCompleted == true;
    }

    function validPreferences(preferences, profileCompleted) {
      return preferences is map
        && preferences.keys().hasOnly([
          'systems', 'experience', 'mode', 'frequency', 'availability', 'atmosphere', 'bio'
        ])
        && preferences.systems is list
        && preferences.systems.size() <= 12
        && preferences.experience is string
        && preferences.mode in ['Presencial', 'Online', 'Mixto']
        && preferences.frequency is string
        && preferences.availability is string
        && preferences.atmosphere is string
        && preferences.bio is string
        && preferences.bio.size() <= 500
        && (!profileCompleted || (
          preferences.systems.size() > 0
          && preferences.experience.size() > 0
          && preferences.frequency.size() > 0
          && preferences.availability.size() > 0
          && preferences.atmosphere.size() > 0
          && preferences.bio.size() >= 50
        ));
    }

    function validPublicProfile(userId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'uid', 'displayName', 'firstName', 'lastName', 'role', 'province',
          'city', 'photoURL', 'avatarClass', 'avatarType', 'active', 'profileCompleted', 'preferences',
          'createdAt', 'updatedAt'
        ])
        && data.uid == userId
        && data.displayName is string
        && data.displayName.size() <= 101
        && data.firstName is string
        && data.firstName.size() <= 50
        && data.lastName is string
        && data.lastName.size() <= 50
        && validRole(data.role)
        && data.province == 'Mendoza'
        && data.city is string
        && data.city.size() <= 80
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000))
        && validAvatarClass(data.avatarClass)
        && (!('avatarType' in data) || data.avatarType is string)
        && data.active is bool
        && data.profileCompleted is bool
        && validPreferences(data.preferences, data.profileCompleted)
        && data.updatedAt == request.time
        && (!data.profileCompleted || (
          data.firstName.size() >= 2
          && data.lastName.size() >= 2
          && data.city.size() >= 2
          && getAfter(/databases/$(database)/documents/userPrivate/$(userId)).data.privacyConsent == true
          && getAfter(/databases/$(database)/documents/userPrivate/$(userId)).data.whatsappNumber is string
        ));
    }

    function validPrivateProfile(userId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'uid', 'whatsappNumber', 'whatsappUrl', 'instagramUsername',
          'instagramUrl', 'alternatePhone', 'privacyConsent',
          'privacyConsentAt', 'createdAt', 'updatedAt'
        ])
        && data.uid == userId
        && data.whatsappNumber is string
        && data.whatsappNumber.matches('^549[0-9]{10}$')
        && data.whatsappUrl == 'https://wa.me/' + data.whatsappNumber
        && data.instagramUsername is string
        && data.instagramUsername.size() <= 30
        && data.instagramUrl is string
        && ((data.instagramUsername == '' && data.instagramUrl == '')
          || data.instagramUrl == 'https://www.instagram.com/' + data.instagramUsername + '/')
        && data.alternatePhone is string
        && data.alternatePhone.size() <= 15
        && data.privacyConsent == true
        && data.updatedAt == request.time;
    }

    function viewerCanSeeContact(targetUid) {
      return signedIn()
        && request.auth.uid != targetUid
        && currentUserData().active == true
        && currentUserData().profileCompleted == true
        && (currentUserData().role == 'DM' || currentUserData().role == 'BOTH')
        && get(/databases/$(database)/documents/users/$(targetUid)).data.active == true
        && get(/databases/$(database)/documents/users/$(targetUid)).data.profileCompleted == true
        && resource.data.privacyConsent == true
        && !exists(/databases/$(database)/documents/users/$(targetUid)/blockedUsers/$(request.auth.uid))
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/blockedUsers/$(targetUid));
    }

    match /users/{userId} {
      allow get: if ownDocument(userId) || completedViewer();
      allow list: if completedViewer();
      allow create: if ownDocument(userId)
        && validPublicProfile(userId)
        && request.resource.data.active == true
        && request.resource.data.createdAt == request.time;
      allow update: if ownDocument(userId)
        && validPublicProfile(userId)
        && (!('uid' in resource.data) || request.resource.data.uid == resource.data.uid)
        && ((!('active' in resource.data) && request.resource.data.active == true)
          || request.resource.data.active == resource.data.active)
        && ((!('createdAt' in resource.data) && request.resource.data.createdAt == request.time)
          || request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if false;

      match /blockedUsers/{blockedUid} {
        allow get, list: if ownDocument(userId);
        allow create: if ownDocument(userId)
          && request.resource.data.keys().hasOnly(['uid', 'displayName', 'createdAt'])
          && request.resource.data.uid == blockedUid
          && request.resource.data.displayName is string
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if ownDocument(userId);
      }

      match /blockedBy/{blockerUid} {
        allow get, list: if ownDocument(userId);
        allow create: if signedIn()
          && request.auth.uid == blockerUid
          && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
          && request.resource.data.uid == blockerUid
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if signedIn() && request.auth.uid == blockerUid;
      }
    }

    match /userPrivate/{userId} {
      allow get: if ownDocument(userId) || viewerCanSeeContact(userId);
      allow list: if false;
      allow create: if ownDocument(userId)
        && validPrivateProfile(userId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.privacyConsentAt == request.time;
      allow update: if ownDocument(userId)
        && validPrivateProfile(userId)
        && (!('uid' in resource.data) || request.resource.data.uid == resource.data.uid)
        && ((!('createdAt' in resource.data) && request.resource.data.createdAt == request.time)
          || request.resource.data.createdAt == resource.data.createdAt)
        && ((!('privacyConsentAt' in resource.data) && request.resource.data.privacyConsentAt == request.time)
          || request.resource.data.privacyConsentAt == resource.data.privacyConsentAt);
      allow delete: if ownDocument(userId);
    }

    match /gameJoinRequests/{requestId} {
      allow get, list: if signedIn()
        && (resource.data.playerUid == request.auth.uid || resource.data.dmUid == request.auth.uid);
      // Las solicitudes se crean en Apps Script después de validar el token y
      // obtener el creatorUid directamente desde la partida en Sheets.
      allow create, delete: if false;
      allow update: if signedIn()
        && resource.data.dmUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'seenByDm', 'seenAt', 'updatedAt'
        ])
        && request.resource.data.id == resource.data.id
        && request.resource.data.gameId == resource.data.gameId
        && request.resource.data.playerUid == resource.data.playerUid
        && request.resource.data.dmUid == resource.data.dmUid
        && request.resource.data.status == resource.data.status
        && request.resource.data.seenByDm == true
        && request.resource.data.updatedAt == request.time
        && resource.data.status == 'PENDING'
        && request.resource.data.seenAt == request.time
        && !('resolvedAt' in request.resource.data);
    }

    match /gameParticipants/{participantId} {
      // Apps Script crea y modifica participantes después de validar el token,
      // la propiedad de la partida y el cupo disponible en Google Sheets.
      allow get, list: if completedViewer();
      allow create, update, delete: if false;
    }

    match /users/{userId}/notifications/{notificationId} {
      allow get, list: if ownDocument(userId);
      // Las notificaciones de negocio se crean en el backend junto con el
      // cambio de solicitud. El navegador solamente puede marcarlas como leídas.
      allow create: if false;
      allow update: if ownDocument(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])
        && request.resource.data.read == true
        && request.resource.data.readAt == request.time;
      allow delete: if ownDocument(userId);
    }

    match /conversations/{document=**} {
      allow read, write: if false;
    }
  }
}
